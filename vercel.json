{
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "https://admin-rho-one-33.vercel.app/admin/$1"
    },
    {
      "src": "/admin",
      "dest": "https://admin-rho-one-33.vercel.app/admin"
    },
    {
      "src": "/_next/(.*)",
      "dest": "https://admin-rho-one-33.vercel.app/_next/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://admin-rho-one-33.vercel.app/api/$1"
    },
    {
      "src": "/frames/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/assets/media/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
