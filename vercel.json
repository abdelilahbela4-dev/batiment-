{
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
      },
      "continue": true
    },
    {
      "src": "^/(?!admin(?:/|$)|api/|_next/).*",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://vrpbkcyjlpltdbdfkvuw.supabase.co wss://vrpbkcyjlpltdbdfkvuw.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "^/(?:index\\.html)?$",
      "status": 308,
      "headers": { "Location": "/fr/" }
    },
    {
      "src": "^/fr(?:/index\\.html)?$",
      "status": 308,
      "headers": { "Location": "/fr/" }
    },
    {
      "src": "^/fr/devis(?:/index\\.html)?$",
      "status": 308,
      "headers": { "Location": "/fr/devis/" }
    },
    {
      "src": "/admin/(.*)",
      "dest": "https://admin-rho-one-33.vercel.app/admin/$1"
    },
    {
      "src": "/admin",
      "dest": "https://admin-rho-one-33.vercel.app/admin"
    },
    {
      "src": "/_next/(.*)",
      "dest": "https://admin-rho-one-33.vercel.app/_next/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://admin-rho-one-33.vercel.app/api/$1"
    },
    {
      "src": "/frames/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/assets/media/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/assets/vendor/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
